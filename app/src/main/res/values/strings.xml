    <!-- onboarding: intro -->
    <string name="onboarding_intro_title">Walk more.\nScroll less.</string>
    <string name="onboarding_intro_body">Lookup senses when you’re walking with your eyes on the screen and raises a warning bar over your status bar — blue, then amber, then red as the risk climbs.</string>
    <string name="onboarding_intro_demo_caption">This is how the bar reacts as confidence grows.</string>

    <!-- onboarding: how it works -->
    <string name="onboarding_how_title">How detection works</string>
    <string name="onboarding_step1_title">It hears your steps</string>
    <string name="onboarding_step1_body">Your accelerometer reveals a walking rhythm. The engine learns your gait over time and tunes itself to it.</string>
    <string name="onboarding_step2_title">It sees where the phone is</string>
    <string name="onboarding_step2_body">The tilt of the screen and the proximity sensor tell the engine whether the display is up in front of your face — or in your pocket.</string>
    <string name="onboarding_step3_title">It warns you in real time</string>
    <string name="onboarding_step3_body">Walking while looking at the screen makes the bar turn red. Everything runs on your device; nothing ever leaves your phone.</string>

    <!-- onboarding: permissions -->
    <string name="onboarding_permissions_title">Three things to allow</string>
    <string name="onboarding_overlay_title">Draw over other apps</string>
    <string name="onboarding_overlay_body">The warning must appear above whatever app you’re walking with. Lookup draws only a thin bar at the top of the screen — nothing else.</string>
    <string name="onboarding_overlay_action">Allow overlay</string>
    <string name="onboarding_notifications_title">Notifications</string>
    <string name="onboarding_notifications_title_not_needed">Notifications (not needed)</string>
    <string name="onboarding_notifications_body">Android requires an ongoing notification while the sensor service runs in the background. It stays silent and never interrupts you.</string>
    <string name="onboarding_notifications_body_not_needed">Your Android version shows the background notification without asking for permission.</string>
    <string name="onboarding_notifications_action">Allow notifications</string>
    <string name="onboarding_battery_title">Run in the background</string>
    <string name="onboarding_battery_body">The watch only works if it can run continuously — that’s the whole feature. Without this exemption most phone brands will kill it within minutes of you pocketing the phone, and the bar won’t be there when you need it. You can skip this, but expect the service to be unreliable on many devices.</string>
    <string name="onboarding_battery_action">Allow in background</string>

