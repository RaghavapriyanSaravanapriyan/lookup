<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Backups are disabled (allowBackup=false); these rules make that
         explicit on API 31+ where allowBackup is deprecated. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
